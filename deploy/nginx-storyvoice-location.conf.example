location = /StoryVoice {
    return 308 /StoryVoice/;
}

location = /StoryVoice/api/external/v1/speech {
    access_log off;
    client_max_body_size 4k;
    client_body_buffer_size 4k;
    error_page 413 = @storyvoice_external_voice_request_too_large;
    proxy_pass http://127.0.0.1:3000/api/external/v1/speech;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /StoryVoice;

    proxy_http_version 1.1;
    proxy_request_buffering on;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# Reject case or trailing-slash variants before the generic 11 MiB proxy. The
# exact lowercase location above is the only supported API path.
location ~* ^/StoryVoice/api/external/v1/speech/?$ {
    access_log off;
    client_max_body_size 4k;
    client_body_buffer_size 4k;
    default_type application/problem+json;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
    return 400 '{"type":"about:blank","title":"Invalid request","status":400,"detail":"Use the canonical external voice API path.","code":"invalid_request"}';
}

location @storyvoice_external_voice_request_too_large {
    access_log off;
    default_type application/problem+json;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
    return 413 '{"type":"about:blank","title":"Request too large","status":413,"detail":"The request body exceeds the configured limit.","code":"request_too_large"}';
}

location /StoryVoice/ {
    client_max_body_size 11m;
    proxy_pass http://127.0.0.1:3000/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /StoryVoice;

    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
