{
  "manifest_version": 3,
  "name": "StoryVoice 博客來書櫃 Companion",
  "version": "0.3.1",
  "description": "從目前開啟的博客來電子書櫃同步已呈現的書籍 metadata 到 StoryVoice。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://viewer-ebook.books.com.tw/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://aiprod.wrbtycg.tw/StoryVoice/*"
  ],
  "action": {
    "default_title": "同步博客來書櫃到 StoryVoice",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://viewer-ebook.books.com.tw/viewer/*"],
      "js": ["extractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
