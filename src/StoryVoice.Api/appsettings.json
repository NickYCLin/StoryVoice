{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=storyvoice;Username=storyvoice;Password=storyvoice_local",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "BookStorage": {
    "RootPath": "storage/books"
  },
  "CharacterVoiceStorage": {
    "RootPath": "storage/character-voices"
  },
  "CharacterAvatarStorage": {
    "RootPath": "storage/character-avatars"
  },
  "ThreeWaAiHub": {
    "BaseUrl": "https://3wa.tw/3waAIHub/",
    "ApiToken": ""
  },
  "Narration": {
    "AdmissionEnabled": false
  },
  "LocalLlmCharacterAnalysis": {
    "BaseUrl": "http://host.docker.internal:11434/",
    "Model": "gpt-oss:20b",
    "ReasoningEffort": "low",
    "NumContext": 16384,
    "TimeoutSeconds": 600,
    "UnloadTimeoutSeconds": 15,
    "MaximumResponseBytes": 16384
  },
  "MultiCharacterNarration": {
    "ProviderVersion": "edge-tts-7.2.8",
    "ChapterPauseMs": 700,
    "CompositionVersion": "edge-tts-multi-voice-v1",
    "FfmpegProfile": "concat-demuxer-mp3-v1"
  },
  "ReverseProxy": {
    "PathBase": "/StoryVoice"
  },
  "SeriesVoiceCatalog": {
    "Voices": [
      {
        "Provider": "edge",
        "Voice": "zh-TW-HsiaoChenNeural",
        "DisplayName": "曉臻（女聲）",
        "Locale": "zh-TW"
      },
      {
        "Provider": "edge",
        "Voice": "zh-TW-YunJheNeural",
        "DisplayName": "雲哲（男聲）",
        "Locale": "zh-TW"
      },
      {
        "Provider": "edge",
        "Voice": "zh-CN-YunxiNeural",
        "DisplayName": "雲希（男聲）",
        "Locale": "zh-CN"
      },
      {
        "Provider": "edge",
        "Voice": "zh-CN-YunjianNeural",
        "DisplayName": "雲健（男聲）",
        "Locale": "zh-CN"
      },
      {
        "Provider": "edge",
        "Voice": "zh-CN-XiaoxiaoNeural",
        "DisplayName": "曉曉（女聲）",
        "Locale": "zh-CN"
      },
      {
        "Provider": "edge",
        "Voice": "zh-CN-XiaoyiNeural",
        "DisplayName": "曉伊（女聲）",
        "Locale": "zh-CN"
      },
      {
        "Provider": "edge",
        "Voice": "zh-TW-HsiaoYuNeural",
        "DisplayName": "曉雨（女聲）",
        "Locale": "zh-TW"
      },
      {
        "Provider": "3wa-voxcpm2",
        "Voice": "custom",
        "DisplayName": "自訂聲線（角色聲線工作室）",
        "Locale": "zh-TW"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
